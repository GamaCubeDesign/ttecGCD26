(version 1)
(rule "circuibras_trilha_externa_padrao"
  (constraint track_width (min 0.127mm))
  (severity warning)
)
(rule "circuibras_trilha_externa_limite"
  (constraint track_width (min 0.101mm))
  (severity error)
)
(rule circuibras_isolacao_externa_padrao
	(constraint clearance (min 0.2mm))

	(severity warning))
(rule circuibras_isolacao_externa_limite
	(constraint clearance (min 0.2mm))
)
(rule "circuibras_anel_minimo_padrao"
  (constraint annular_width (min 0.12mm))
  (severity warning)
)
(rule "circuibras_anel_minimo_limite"
  (constraint annular_width (min 0.101mm))
  (severity error)
)
(rule "circuibras_cobre_furo"
  (constraint hole_clearance (min 0.2mm))
  (severity error)
)
(rule "circuibras_cobre_borda"
  (constraint edge_clearance (min 0.3mm))
  (severity error)
)
(rule "circuibras_furo_borda"
  (constraint physical_hole_clearance (min 0.4mm))
  (condition "B.Layer == 'Edge.Cuts'")
  (severity error)
)
(rule "circuibras_pad_a_pad_dam"
  (constraint physical_clearance (min 0.225mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (severity warning)
)
(rule "circuibras_pad_a_pad_limite"
  (constraint physical_clearance (min 0.187mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (severity error)
)
(rule "circuibras_serigrafia_pad"
  (constraint silk_clearance (min 0.127mm))
  (severity warning)
)
(rule "circuibras_texto_altura"
  (constraint text_height (min 0.7mm))
  (severity error)
)
(rule "circuibras_texto_traco"
  (constraint text_thickness (min 0.101mm))
  (severity error)
)
(rule "circuibras_sem_via_cega"
  (constraint disallow micro_via buried_via)
)
