# ESP32 DevKit V1 (ESP-WROOM-32, 4 MB flash) as the ground station (ADR-0018).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1 ms ticks: the link's timing is in milliseconds (reply gap 20 ms, ADR-0007).
CONFIG_FREERTOS_HZ=1000
# The console's buffers are static; the radio's FIFO bursts are on the stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# UART0, through the board's USB bridge, carries the JSON lines.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y
CONFIG_NEWLIB_STDIN_LINE_ENDING_LF=y
# Full printf: the console prints doubles (lat, lon, PER).
# CONFIG_NEWLIB_NANO_FORMAT is not set
