# build trees
/build*/
/venv/

# ESP-IDF
/ground/esp32/build/
/ground/esp32/sdkconfig
/ground/esp32/sdkconfig.old

# mission data: regenerated per run, never committed
*.ndjson
*.jsonl
/flight/**/*.log
# ...except the bench logs and onboard records: test evidence for the Design
# Package (make bench, adsbd with the SDR)
!/docs/vv/bancada/**/*.jsonl
!/docs/vv/bancada/**/*.ndjson

# per-machine Makefile settings (PI_HOST, ...)
/local.mk

# python
__pycache__/
*.pyc

# editor
.vscode/
.idea/
compile_commands.json

# CDR LaTeX source: local backup only; the Overleaf project is the source of
# truth and the delivered PDF is in docs/cdr/
/docs/cdr/fonte-overleaf/

# per-machine notes with credentials (the Pi's login)
/rasp_config.md

# KiCad: per-user and generated files, if a board is opened from hardware/
*.kicad_prl
*-backups/
fp-info-cache
*.lck
*.kicad_pro.bak
