# ttcd — Gama TT&C daemon: the LoRa link, telecommands and telemetry.
#
# Install:
#   sudo install -m 0755 build/flight/ttcd /usr/local/bin/ttcd
#   sudo install -D -m 0644 flight/ttcd/ttcd.conf.example /etc/gama/ttcd.conf
#   sudo install -m 0644 flight/ttcd/ttcd.service /etc/systemd/system/
#   sudo useradd --system --no-create-home --groups spi,gpio gama
#   sudo systemctl daemon-reload && sudo systemctl enable --now ttcd
#
# ttcd must be listening before adsbd and the OBC connect; both retry their
# connection, so start order only affects how soon they succeed (ADR-0005).

[Unit]
Description=Gama TT&C daemon (ttcd)
Documentation=file:///usr/local/share/doc/gama/adr

[Service]
Type=simple
ExecStart=/usr/local/bin/ttcd -c /etc/gama/ttcd.conf
User=gama
Group=gama
SupplementaryGroups=spi gpio

# The radio is the only way to recover the satellite: always restart it —
# except after a commanded SHUTDOWN, which exits with 64 (TTCD_EXIT_SHUTDOWN).
Restart=always
RestartSec=2
RestartPreventExitStatus=64

# /run/gama holds the IPC socket and is shared with adsbd and the OBC;
# preserve it when this unit stops, so the others' sockets are not removed.
RuntimeDirectory=gama
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
# /var/lib/gama holds the logs (log_path).
StateDirectory=gama

# Only the radio's devices. No root, no new privileges, read-only system.
DevicePolicy=closed
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/gpiochip0 rw
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gama /run/gama

[Install]
WantedBy=multi-user.target
